  {
   "type": "short",
   "content": "Для якого значення <span data-latex=\"x_{0}\" data-type=\"inline-math\"></span> функція <span data-latex=\"y = 2x^{3} - 3x^{2} - 12x + 5\" data-type=\"inline-math\"></span> набуває свого найбільшого значення на проміжку <span data-latex=\"[-2; 3]\" data-type=\"inline-math\"></span>?",
   "variants": [],
   "points": 2,
   "solution": "<span data-latex=\"y&#x27; = 6(x + 1)(x - 2)\" data-type=\"inline-math\"></span>; <span data-latex=\"y(-2) = 1\" data-type=\"inline-math\"></span>, <span data-latex=\"y(-1) = 12\" data-type=\"inline-math\"></span>, <span data-latex=\"y(2) = -15\" data-type=\"inline-math\"></span>, <span data-latex=\"y(3) = -4\" data-type=\"inline-math\"></span>"
  },
  {
