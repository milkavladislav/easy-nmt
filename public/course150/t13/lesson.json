    "points": 1,
    "solution": "<span data-latex=\"\\dfrac{1}{27} = 3^{-3}\" data-type=\"inline-math\"></span>, тож <span data-latex=\"\\operatorname{log}_{3} \\dfrac{1}{27} = -3\" data-type=\"inline-math\"></span>."
   },
   "answer": 3
  },
  {
   "kind": "theory",
   "tag": "Блок 2 · Властивості",
   "title": "Сума, різниця, степінь",
   "cards": [
    {
     "color": "sun",
     "big": "+",
     "title": "Сума",
     "formula": "",
     "text": "<span data-latex=\"\\operatorname{log}_{a} x + \\operatorname{log}_{a} y = \\operatorname{log}_{a} (xy)\" data-type=\"inline-math\"></span> — лише за <b>однакової</b> основи."
    },
    {
     "color": "mint",
     "big": "−",
     "title": "Різниця",
     "formula": "",
     "text": "<span data-latex=\"\\operatorname{log}_{a} x - \\operatorname{log}_{a} y = \\operatorname{log}_{a} \\dfrac{x}{y}\" data-type=\"inline-math\"></span>."
    },
    {
     "color": "coral",
     "big": "<span data-latex=\"k\" data-type=\"inline-math\"></span>",
     "title": "Степінь",
     "formula": "",
     "text": "<span data-latex=\"\\operatorname{log}_{a} x^{k} = k\\operatorname{log}_{a} x\" data-type=\"inline-math\"></span>. Зокрема <span data-latex=\"\\operatorname{log}_{a} a^{k} = k\" data-type=\"inline-math\"></span>."
    }
   ]
  },
