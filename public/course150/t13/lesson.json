     },
     {
      "id": 1,
      "content": "<span data-latex=\"\\dfrac{1}{3}\" data-type=\"inline-math\"></span>"
     },
     {
      "id": 2,
      "content": "<span data-latex=\"-\\dfrac{1}{3}\" data-type=\"inline-math\"></span>"
     },
     {
      "id": 3,
      "content": "<span data-latex=\"-3\" data-type=\"inline-math\"></span>"
     },
     {
      "id": 4,
      "content": "3"
